# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=flex
DB_PASSWORD=change-me
DB_NAME=flexlearn

# Secret used to sign login tokens (required in production). Generate: openssl rand -hex 32
JWT_SECRET=

# API port (Vite dev server proxies /api to this)
PORT=3001

# First admin account created by `bun run db:create-admin` (password min 8 chars)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
